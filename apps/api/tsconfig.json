{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node",
    "baseUrl": ".",
    "paths": {
      "@jobease/shared-types": ["../../packages/shared-types/dist"],
      "@jobease/field-engine": ["../../packages/field-engine/dist"]
    }
  },
  "include": ["src/**/*"]
}
