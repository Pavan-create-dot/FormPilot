{
  "name": "jobease-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "JobEase - Intelligent Job Application Autofill Assistant",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:extension": "npm run dev --workspace=apps/extension",
    "build:types": "npm run build --workspace=packages/shared-types",
    "build:engine": "npm run build --workspace=packages/field-engine",
    "build:api": "npm run build --workspace=apps/api",
    "build:web": "npm run build --workspace=apps/web",
    "build:extension": "npm run build --workspace=apps/extension",
    "build": "npm run build:types && npm run build:engine && npm run build:api && npm run build:web",
    "vercel-build": "npm run build:types && npm run build:engine && npm run build:api && npm run build:web",
    "test:engine": "npm test --workspace=packages/field-engine",
    "test": "npm test --workspace=packages/field-engine"
  },
  "devDependencies": {
    "typescript": "^5.3.3"
  }
}
